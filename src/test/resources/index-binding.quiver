# A program whose binding-shaped rule must fire.
#
# A binding matches the term it binds, so the rule fires on every subject,
# even though the program also carries a rule whose pattern is an arrow.
@fsm => {
  start => q0
  accepting => $seq [ q1 ]
  mapping => {
    (q0, a) -> (q0, 0)
  }
}

t <- (q0, a) -> ($x, $n) => {
  _ => (q0, b) -> (q1, 0)
}

(q9, z9) => {
  _ => (q0, zzz) -> (q1, 0)
}
