# A program with two identical transitions out of the same state.
#
# Both transitions are a path of their own, so a non-deterministic run
# explores two paths, and the rule below fires once on each of them.
@fsm => {
  start => q0
  accepting => $seq [ q1 ]
  mapping => {
    (q0, a) -> (q0, 0)
    (q0, a) -> (q0, 0)
  }
}

(q0, a) -> ($x, $n) => {
  _ => emit(1)
}
