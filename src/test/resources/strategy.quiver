# Quiver strategy example: a named rewriting strategy, selected by the FSM
# header.
#
# The rule fires once per step under the `first` strategy, and up to three
# times under the `repeat` strategy. The subject of a step is fixed, so the
# rule sees the same transition on every repetition.
#
# "a" is accepted; the empty input and "b" are rejected.

@fsm => {
  start => q0
  accepting => $seq [ q1 ]
  strategy => repeatTest
  mapping => {
    (q0, a) -> (q1, 0)
  }
}

strategy repeatTest repeat max 3 => {
  (q0, a) -> ($x, $n) => {
    (q0, a) -> ($x, $n) => _
    _ => (q0, a) -> ($x, $n + 1)
  }
}
